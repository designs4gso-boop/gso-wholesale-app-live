    "prisma": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.22.3",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@react-router/dev": "^6.22.3",
