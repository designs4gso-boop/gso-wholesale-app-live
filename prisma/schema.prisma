generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model ShopSettings {
  id                   Int      @id @default(autoincrement())
  shop                 String   @unique
  wholesaleTag         String   @default("wholesale_approved")
  pendingTag           String   @default("wholesale_pending")
  vipTag               String   @default("vip_wholesale")
  applicationMode      String   @default("manual")
  storewidePercentOff  Float    @default(0)
  minimumSubtotal      Float    @default(0)
  minCartQuantity      Int      @default(1)
  enforceMinCartQty    Boolean  @default(false)
  lockWholesaleAccess  Boolean  @default(false)
  autoCreateDiscount   Boolean  @default(false)
  wholesaleDiscountId  String?
  validationOwnerId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  rules        WholesaleRule[]
  applications WholesaleApplication[]
}

model WholesaleRule {
  id                 Int      @id @default(autoincrement())
  shop               String
  customerTag        String
  title              String
  scopeType          String
  scopeId            String?
  scopeLabel         String?
  discountType       String
  value              Float
  minQuantity        Int      @default(1)
  minProductQuantity Int?
  minCartQuantity    Int?
  minSubtotal        Float?
  priority           Int      @default(100)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  settingsId Int?
  settings   ShopSettings? @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([shop, active])
  @@index([shop, customerTag])
  @@index([shop, scopeType, scopeId])
}

model WholesaleApplication {
  id             Int      @id @default(autoincrement())
  shop           String
  customerId     String
  email          String
  companyName    String?
  phone          String?
  taxId          String?
  resaleNumber   String?
  notes          String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  settingsId Int?
  settings   ShopSettings? @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([shop, status])
}
