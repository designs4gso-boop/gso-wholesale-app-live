generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  refreshToken        String?
  refreshTokenExpires DateTime?
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
}

model ShopSettings {
  id                  Int      @id @default(autoincrement())
  shop                String   @unique
  wholesaleTag        String   @default("wholesale_approved")
  pendingTag          String   @default("wholesale_pending")
  vipTag              String   @default("vip_wholesale")
  applicationMode     String   @default("manual")
  storewidePercentOff Float    @default(0)
  minimumSubtotal     Float    @default(0)
  minCartQuantity     Int      @default(1)
  enforceMinCartQty   Boolean  @default(false)
  lockWholesaleAccess Boolean  @default(false)
  autoCreateDiscount  Boolean  @default(false)
  wholesaleDiscountId String?
  validationOwnerId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  rules        WholesaleRule[]
  applications WholesaleApplication[]
}

model WholesaleRule {
  id                 Int      @id @default(autoincrement())
  shop               String
  customerTag        String
  title              String
  scopeType          String
  scopeId            String?
  scopeLabel         String?
  discountType       String
  value              Float
  minQuantity        Int      @default(1)
  minProductQuantity Int?
  minCartQuantity    Int?
  minSubtotal        Float?
  priority           Int      @default(100)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  settingsId Int?
  settings   ShopSettings? @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([shop, active])
  @@index([shop, customerTag])
  @@index([shop, scopeType, scopeId])
}

model WholesaleApplication {
  id           Int      @id @default(autoincrement())
  shop         String
  customerId   String
  email        String
  companyName  String?
  phone        String?
  taxId        String?
  resaleNumber String?
  notes        String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settingsId Int?
  settings   ShopSettings? @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([shop, status])
}

model PricingRule {
  id    String @id @default(cuid())
  shop  String
  title String

  customerTag String?
  productTag  String?
  productGid  String?
  variantGid  String?
  sku         String?

  minQty       Int    @default(1)
  discountType String @default("fixed_price") // fixed_price or percent_off
  sellPrice    Float?
  percentOff   Float?
  unitCost     Float?

  priority  Int      @default(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, active])
  @@index([shop, customerTag])
  @@index([shop, productTag])
  @@index([shop, variantGid])
  @@index([shop, sku])
}

model CostCalculator {
  id              String   @id @default(cuid())
  shop            String
  title           String
  materialCost    Float
  printCost       Float
  laborCost       Float
  machineCost     Float
  wastePercent    Float
  packagingCost   Float
  setupFee        Float
  suggestedMargin Float
  createdAt       DateTime @default(now())
}

model Quote {
  id           String      @id @default(cuid())
  shop         String
  customerName String?
  company      String?
  email        String?
  phone        String?
  status       String      @default("draft")
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        QuoteItem[]

  depositAmount       Float   @default(0)
  balanceDue          Float   @default(0)
  depositCreated      Boolean @default(false)
  balanceCreated      Boolean @default(false)
  fullOrderCreated    Boolean @default(false)
  depositDraftOrderId String?
  balanceDraftOrderId String?
  fullDraftOrderId    String?

  depositInvoiceUrl String?
  balanceInvoiceUrl String?
  fullInvoiceUrl    String?

  @@index([shop, status])
  @@index([shop, createdAt])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  productName String
  variant     String?
  sku         String?
  quantity    Int
  unitPrice   Float
  unitCost    Float
  notes       String?

  // Visual and Shopify source snapshots for production/proof workflow.
  productImageUrl   String?
  artworkUrl        String?
  proofUrl          String?
  shopifyProductGid String?
  shopifyVariantGid String?

  // ERP recipe snapshot fields. These make quote items pull from Product Setup / Recipes
  // while preserving the exact cost, price, finish, tier, and margin used at quote time.
  recipeId         String?
  recipeName       String?
  selectedFinish   String?
  selectedAddOnIds String?
  pricingSource    String?
  tierLabel        String?
  minQuantity      Int?
  marginPct        Float?
  costSnapshot     String?
  priceSnapshot    String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([recipeId])
  @@index([sku])
  @@index([shopifyProductGid])
  @@index([shopifyVariantGid])
}

model ProductCost {
  id   String @id @default(cuid())
  shop String @default("")

  productId   String?
  variantId   String?
  sku         String?
  productName String?
  name        String?

  materialCost  Float @default(0)
  printCost     Float @default(0)
  laborCost     Float @default(0)
  machineCost   Float @default(0)
  packagingCost Float @default(0)

  customCosts Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([variantId])
  @@index([sku])
  @@index([productName])
}

model ProductCategory {
  id        String   @id @default(cuid())
  shop      String
  name      String
  slug      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes   ProductRecipe[]
  materials Material[]

  @@unique([shop, slug])
  @@index([shop])
}

model Material {
  id               String   @id @default(cuid())
  shop             String
  categoryId       String?
  name             String
  materialType     String   @default("general") // label, dtp, box, ink, laminate, labor, machine, general
  productFamilies  String   @default("") // comma-separated product families such as labels, sticker_bags, boxes
  costReviewNeeded Boolean  @default(false)
  useInRecipes     Boolean  @default(true)
  unit             String   @default("each") // each, sqft, linear_ft, ml, hour, roll, sheet
  costPerUnit      Float    @default(0)
  vendor           String?
  primaryVendorId  String?
  sku              String?
  stockOnHand      Float?
  reorderPoint     Float?
  leadTimeDays     Int?
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  purchaseUnit     String   @default("each") // roll, cartridge, gallon, case, each, hour
  purchaseCost     Float    @default(0)

  baseUnit      String  @default("each") // sqft, sqin, ml, each, hour
  yieldQuantity Float?
  yieldUnit     String?

  rollWidthIn  Float?
  rollLengthFt Float?
  volumeMl     Float?
  caseQuantity Float?

  calculatedUnitCost Float @default(0)

  primaryVendor      Vendor?                     @relation("MaterialPrimaryVendor", fields: [primaryVendorId], references: [id], onDelete: SetNull)
  category           ProductCategory?            @relation(fields: [categoryId], references: [id])
  recipeMaterials    RecipeMaterial[]
  costHistory        MaterialCostHistory[]
  vendors            MaterialVendor[]
  productionUsages   ProductionMaterialUsage[]
  inventoryMovements MaterialInventoryMovement[]
  variants           MaterialVariant[]
  recipeMediaOptions RecipeMediaOption[]
  recipeLabelZones   RecipeLabelZone[]

  @@index([shop])
  @@index([shop, materialType])
  @@index([shop, productFamilies])
  @@index([shop, active])
  @@index([shop, costReviewNeeded])
  @@index([shop, useInRecipes])
  @@index([primaryVendorId])
}

model MaterialVariant {
  id           String   @id @default(cuid())
  shop         String
  materialId   String
  name         String
  color        String?
  sku          String?
  stockOnHand  Float?
  reorderPoint Float?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([materialId])
  @@index([shop, active])
}

model ProductTypeProfile {
  id               String   @id @default(cuid())
  shop             String
  key              String
  name             String
  productionMode   String   @default("in_house") // in_house, outsourced, hybrid
  minQuantity      Int      @default(1)
  defaultQuantity  Int      @default(1)
  tierBreakpoints  String   @default("1") // comma-separated tier start quantities
  tierTemplate     String? // JSON range rows with margin/fixed price defaults
  defaultMarginPct Float    @default(40)
  pricingMethod    String   @default("auto_margin") // auto_margin, fixed_price, discount_from_first, markup_over_cost
  defaultTags      String? // comma-separated Shopify tags to apply later
  calculatorKind   String?  // label, box, dtp, jar, sticker_bag, sourced, general
  calculatorRoutesJson String? // JSON route config used by the custom product cost calculator
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipes ProductRecipe[]

  @@unique([shop, key])
  @@index([shop])
  @@index([shop, active])
  @@index([key])
}

model ProductRecipe {
  id                             String  @id @default(cuid())
  shop                           String
  categoryId                     String?
  productTypeProfileId           String?
  name                           String
  sku                            String?
  productType                    String  @default("label") // label, dtp_bag, box, sourced_product, die_cut_bag, general
  productFamily                  String  @default("Labels") // Labels, Sticker Bags, DTP Bags, Boxes, DTF / Apparel, custom
  pricingTemplateMode            String   @default("template") // template, custom
  costReviewNeeded               Boolean  @default(false)
  costReviewReasons              String?
  costReviewSyncedAt             DateTime?
  costReviewSource               String?
  useInQuotes                    Boolean  @default(true)
  applicationLaborSecondsPerUnit Float   @default(0)
  packingLaborSecondsPerUnit     Float   @default(0)
  prepressMinutes                Float   @default(0)
  productGid                     String?
  variantGid                     String?
  shopifyProductId               String?
  shopifyVariantId               String?
  shopifyTargetMode              String  @default("product_all_variants")
  shopifyVariantIds              String?
  costMethod                     String  @default("recipe") // recipe, sourced_flat, sourced_tier
  productionMode                 String  @default("in_house") // in_house, outsourced, hybrid
  vendorProductId                String?

  widthIn         Float?
  heightIn        Float?
  depthIn         Float?
  minQuantity     Int    @default(1)
  defaultQuantity Int    @default(1000)

  // Label estimating defaults. These keep the employee UI simple while the calculator
  // prices white/gloss/emboss options and slower production time in the background.
  baseCmykCoveragePct        Float @default(40)
  inkAllowancePct            Float @default(15)
  maintenanceCostPerSqft     Float @default(0.08)
  machineRecoveryCostPerSqft Float @default(0.05)
  overheadCostPerSqft        Float @default(0)
  operatorLaborPct           Float @default(25)

  defaultSellPrice Float?
  targetMarginPct  Float    @default(40)
  wastePct         Float    @default(0)
  setupCost        Float    @default(0)
  laborMinutes     Float    @default(0)
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category           ProductCategory?       @relation(fields: [categoryId], references: [id])
  productTypeProfile ProductTypeProfile?    @relation(fields: [productTypeProfileId], references: [id])
  vendorProduct      VendorProduct?         @relation(fields: [vendorProductId], references: [id])
  materials          RecipeMaterial[]
  labelZones         RecipeLabelZone[]
  mediaOptions       RecipeMediaOption[]
  inkRequirements    RecipeInkRequirement[]
  machineRules       RecipeMachineRule[]
  tiers              RecipeTier[]
  sourcedTiers       SourcedCostTier[]
  addOns             RecipeAddOn[]
  variantRules       RecipeVariantRule[]

  @@index([shop])
  @@index([shop, productType])
  @@index([productTypeProfileId])
  @@index([shop, productionMode])
  @@index([shop, sku])
  @@index([shop, productGid])
  @@index([shop, variantGid])
  @@index([shop, shopifyTargetMode])
  @@index([shop, active])
  @@index([vendorProductId])
}

model VendorProduct {
  id              String   @id @default(cuid())
  shop            String
  name            String
  productType     String   @default("sourced_product") // box, dtp_bag, die_cut_bag, sourced_product, general
  vendor          String?
  vendorId        String?
  vendorSku       String?
  moq             Int      @default(1)
  defaultUnitCost Float    @default(0)
  leadTimeDays    Int?
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorRecord Vendor?              @relation("VendorProductVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  recipes      ProductRecipe[]
  tiers        VendorProductTier[]
  addOns       VendorProductAddOn[]

  @@index([shop])
  @@index([shop, active])
  @@index([productType])
  @@index([vendor])
  @@index([vendorId])
}

model VendorProductTier {
  id              String   @id @default(cuid())
  shop            String
  vendorProductId String
  minQty          Int
  maxQty          Int?
  unitCost        Float
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorProduct VendorProduct @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([vendorProductId])
  @@index([minQty])
}

model VendorProductAddOn {
  id              String   @id @default(cuid())
  shop            String
  vendorProductId String
  name            String
  pricingType     String   @default("per_unit") // per_unit, flat_fee, percent, included
  amount          Float    @default(0)
  enabled         Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorProduct VendorProduct @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([vendorProductId])
  @@index([pricingType])
}

model RecipeVariantRule {
  id                  String   @id @default(cuid())
  shop                String
  recipeId            String
  name                String
  shopifyProductGid   String?
  shopifyVariantGid   String?
  shopifyVariantTitle String?
  sku                 String?
  sideMode            String   @default("single") // single, double_same, double_mixed, custom
  bagColor            String?
  frontMediaOptionId  String?
  backMediaMode       String   @default("same_as_front") // same_as_front, specific, none
  backMediaOptionId   String?
  useFrontZone        Boolean  @default(true)
  useBackZone         Boolean  @default(false)
  active              Boolean  @default(true)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  recipe ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([recipeId])
  @@index([shop, active])
  @@index([shop, shopifyProductGid])
  @@index([shop, shopifyVariantGid])
  @@index([sku])
}

model RecipeMediaOption {
  id              String   @id @default(cuid())
  shop            String
  recipeId        String
  name            String
  materialId      String
  defaultOption   Boolean  @default(false)
  premiumOption   Boolean  @default(false)
  priceAdjustPct  Float    @default(0)
  priceAdjustFlat Float    @default(0)
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipe     ProductRecipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material   Material          @relation(fields: [materialId], references: [id])
  labelZones RecipeLabelZone[]

  @@index([shop])
  @@index([recipeId])
  @@index([materialId])
  @@index([shop, active])
}

model RecipeLabelZone {
  id                         String   @id @default(cuid())
  shop                       String
  recipeId                   String
  materialId                 String?
  mediaMode                  String   @default("fixed") // fixed, media_option, same_as_zone
  mediaOptionId              String?
  sameAsZoneId               String?
  name                       String
  position                   String? // Front, Back, Lid, Side, Bottom, Custom
  widthIn                    Float    @default(0)
  heightIn                   Float    @default(0)
  qtyPerUnit                 Float    @default(1)
  applicationSecondsPerLabel Float    @default(0)
  required                   Boolean  @default(true)
  active                     Boolean  @default(true)
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  recipe      ProductRecipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material    Material?          @relation(fields: [materialId], references: [id], onDelete: SetNull)
  mediaOption RecipeMediaOption? @relation(fields: [mediaOptionId], references: [id], onDelete: SetNull)

  @@index([shop])
  @@index([recipeId])
  @@index([materialId])
  @@index([mediaOptionId])
  @@index([shop, active])
}

model RecipeMaterial {
  id           String   @id @default(cuid())
  shop         String
  recipeId     String
  materialId   String
  usageType    String   @default("media") // media, laminate, blank, packaging, sourced, other
  quantity     Float    @default(1)
  unit         String   @default("sqft") // sqft, sqin, each, ml, hour
  wastePct     Float    @default(0)
  includeWaste Boolean  @default(true)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipe   ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id])

  @@index([shop])
  @@index([recipeId])
  @@index([materialId])
  @@index([usageType])
  @@index([shop, active])
}

model RecipeInkRequirement {
  id              String   @id @default(cuid())
  shop            String
  recipeId        String
  inkType         String // cmyk, white, gloss, orange, red, green, primer, metallic, other
  coveragePercent Float    @default(0)
  required        Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipe ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([recipeId])
  @@index([inkType])
}

model RecipeMachineRule {
  id                 String   @id @default(cuid())
  shop               String
  recipeId           String
  preferredMachineId String?
  requiredInkTypes   String? // comma-separated list for simple routing: cmyk,white,gloss
  allowOverflow      Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recipe           ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  preferredMachine Machine?      @relation(fields: [preferredMachineId], references: [id])

  @@index([shop])
  @@index([recipeId])
  @@index([preferredMachineId])
}

model RecipeTier {
  id         String   @id @default(cuid())
  shop       String
  recipeId   String
  minQty     Int
  maxQty     Int?
  marginPct  Float?
  fixedPrice Float?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recipe ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([recipeId])
  @@index([minQty])
}

model RecipeAddOn {
  id          String   @id @default(cuid())
  shop        String
  recipeId    String
  name        String
  pricingType String   @default("per_unit") // per_unit, flat_fee, percent, included
  amount      Float    @default(0)
  enabled     Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([recipeId])
  @@index([pricingType])
}

model SourcedCostTier {
  id        String   @id @default(cuid())
  shop      String
  recipeId  String
  minQty    Int
  unitCost  Float
  vendor    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([recipeId])
  @@index([minQty])
}

model MaterialCostHistory {
  id         String   @id @default(cuid())
  shop       String
  materialId String
  oldCost    Float
  newCost    Float
  vendor     String?
  reason     String?
  changedBy  String?
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([materialId])
}

model MaterialVendor {
  id           String   @id @default(cuid())
  shop         String
  materialId   String
  vendorName   String
  vendorSku    String?
  unitCost     Float    @default(0)
  unit         String   @default("each")
  moq          Float?
  leadTimeDays Int?
  notes        String?
  preferred    Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([materialId])
  @@index([shop, active])
}

model Machine {
  id   String @id @default(cuid())
  shop String

  name          String
  machineType   String @default("printer") // printer, cutter, laminator, press
  maxWidthIn    Float?
  costPerHour   Float  @default(0)
  sqftPerHour   Float  @default(0)
  setupWastePct Float  @default(0)

  allowOverflow Boolean @default(false)
  active        Boolean @default(true)

  inkChannels MachineInkChannel[]
  recipeRules RecipeMachineRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([shop, active])
}

model MachineInkChannel {
  id        String @id @default(cuid())
  shop      String
  machineId String

  slotNumber Int
  inkName    String // Cyan, Magenta, Yellow, Black, White, Gloss, Orange, Red, Green, etc.
  inkType    String // cmyk, white, gloss, orange, red, green, primer, metallic, other

  costPerMl Float @default(0)

  cartridgeCost Float @default(0)
  cartridgeMl   Float @default(0)
  mlPerSqft1Pct Float @default(0)

  // ML used per sqft at 100% coverage for this ink/channel
  mlPerSqft100 Float @default(0)

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([machineId])
  @@index([inkType])
}

model ProductionJob {
  id              String    @id @default(cuid())
  shop            String
  quoteId         String?
  quoteNumber     String?
  jobTicket       String?
  assetInboxKey   String?
  assetFolderUrl  String?
  sourceFolderUrl String?
  lastAssetSyncAt DateTime?
  customerName    String?
  company         String?
  email           String?
  phone           String?

  status     String    @default("new")
  priority   String    @default("normal")
  dueDate    DateTime?
  assignedTo String?

  customerNotes   String?
  internalNotes   String?
  artworkUrl      String?
  proofUrl        String?
  printFileUrl    String?
  productImageUrl String?

  // Customer-facing proof approval portal fields.
  proofApprovalToken   String?   @unique
  proofStatus          String    @default("draft") // draft, sent, viewed, approved, changes_requested
  proofSentAt          DateTime?
  proofViewedAt        DateTime?
  proofApprovedAt      DateTime?
  proofRejectedAt      DateTime?
  proofCustomerName    String?
  proofCustomerEmail   String?
  proofCustomerComment String?

  actualLaborMinutes    Float     @default(0)
  actualLaborRate       Float     @default(25)
  actualLaborCost       Float     @default(0)
  actualPackingCost     Float     @default(0)
  actualShippingCost    Float     @default(0)
  actualOutsourceCost   Float     @default(0)
  actualOtherCost       Float     @default(0)
  actualReprintCost     Float     @default(0)
  actualTotalCost       Float     @default(0)
  actualFinalProfit     Float     @default(0)
  actualFinalMargin     Float     @default(0)
  actualCostNotes       String?
  actualCostFinalized   Boolean   @default(false)
  actualCostFinalizedAt DateTime?
  actualCostFinalizedBy String?

  alertSentAt DateTime?
  printedAt   DateTime?
  completedAt DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items              ProductionJobItem[]
  files              ProductionJobFile[]
  events             ProductionJobEvent[]
  checklistItems     ProductionChecklistItem[]
  materialUsages     ProductionMaterialUsage[]
  inventoryMovements MaterialInventoryMovement[]

  @@index([shop])
  @@index([shop, status])
  @@index([shop, priority])
  @@index([quoteId])
  @@index([jobTicket])
  @@index([proofApprovalToken])
  @@index([proofStatus])
  @@index([assetInboxKey])
  @@index([dueDate])
}

model ProductionJobItem {
  id                String  @id @default(cuid())
  shop              String
  jobId             String
  quoteItemId       String?
  itemTicket        String?
  ripJobName        String?
  suggestedFileName String?

  productTitle String
  variantTitle String?
  sku          String?
  quantity     Int     @default(1)
  unitPrice    Float   @default(0)
  unitCost     Float   @default(0)

  shopifyProductGid String?
  shopifyVariantGid String?
  productImageUrl   String?
  recipeId          String?
  recipeName        String?
  selectedFinish    String?
  selectedAddOns    String?
  materialSummary   String?
  machineSummary    String?
  costSnapshot      String?
  priceSnapshot     String?
  productionNotes   String?
  sortOrder         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([jobId])
  @@index([quoteItemId])
  @@index([itemTicket])
  @@index([ripJobName])
  @@index([sku])
  @@index([recipeId])
}

model ProductionJobFile {
  id               String   @id @default(cuid())
  shop             String
  jobId            String
  fileName         String
  fileType         String   @default("artwork") // artwork, proof, dieline, customer_pdf, print_file, image, other
  fileUrl          String
  assetRole        String   @default("reference") // productImage, artwork, proof, printFile, reference
  assetSource      String   @default("manual") // manual, google_drive, shopify, zakeke, email, nas, versaworks, rasterlink, generated
  sourceRef        String?
  matchedBy        String?
  jobTicket        String?
  originalFileName String?
  notes            String?
  createdBy        String?
  createdAt        DateTime @default(now())

  job ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([jobId])
  @@index([fileType])
  @@index([assetRole])
  @@index([assetSource])
  @@index([jobTicket])
  @@index([sourceRef])
}

model ProductionJobEvent {
  id        String   @id @default(cuid())
  shop      String
  jobId     String
  eventType String
  message   String
  oldValue  String?
  newValue  String?
  createdBy String?
  createdAt DateTime @default(now())

  job ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([jobId])
  @@index([eventType])
  @@index([createdAt])
}

model ProductionChecklistItem {
  id          String    @id @default(cuid())
  shop        String
  jobId       String
  label       String
  section     String    @default("production") // prepress, production, qc, packing
  completed   Boolean   @default(false)
  completedAt DateTime?
  completedBy String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([jobId])
  @@index([section])
  @@index([completed])
}

model ProductionMaterialUsage {
  id               String    @id @default(cuid())
  shop             String
  jobId            String
  materialId       String?
  materialName     String
  materialType     String? // roll_media, laminate, ink, packaging, labor, outsourced, other
  unit             String    @default("sqft") // sqft, linear_ft, sqin, each, ml, hour, roll, sheet
  estimatedQty     Float     @default(0)
  pulledQty        Float     @default(0)
  usedQty          Float     @default(0)
  wasteQty         Float     @default(0)
  reprintQty       Float     @default(0)
  costPerUnit      Float     @default(0)
  totalCost        Float     @default(0)
  source           String    @default("manual") // manual, recipe, print_log, inventory, vendor_invoice
  stockDeductedQty Float     @default(0)
  stockDeductedAt  DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job      ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  material Material?     @relation(fields: [materialId], references: [id])

  @@index([shop])
  @@index([jobId])
  @@index([materialId])
  @@index([materialType])
  @@index([source])
}

model MaterialInventoryMovement {
  id              String   @id @default(cuid())
  shop            String
  materialId      String
  jobId           String?
  materialUsageId String?
  movementType    String   @default("adjustment") // production_deduction, reversal, purchase, adjustment, waste
  quantity        Float    @default(0) // negative = stock out, positive = stock in
  unit            String   @default("each")
  beforeQty       Float?
  afterQty        Float?
  costPerUnit     Float    @default(0)
  costImpact      Float    @default(0)
  source          String   @default("production")
  reference       String?
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())

  material Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  job      ProductionJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([shop])
  @@index([materialId])
  @@index([jobId])
  @@index([materialUsageId])
  @@index([movementType])
  @@index([createdAt])
}

model PrintLogImport {
  id                String   @id @default(cuid())
  shop              String
  source            String   @default("manual") // versaworks, rasterlink, manual_csv, other
  fileName          String?
  importedBy        String?
  rawText           String?
  rowCount          Int      @default(0)
  matchedCount      Int      @default(0)
  unmatchedCount    Int      @default(0)
  totalSqft         Float    @default(0)
  totalInkMl        Float    @default(0)
  totalPrintMinutes Float    @default(0)
  status            String   @default("processed")
  notes             String?
  createdAt         DateTime @default(now())

  entries PrintLogEntry[]

  @@index([shop])
  @@index([source])
  @@index([createdAt])
}

model PrintLogEntry {
  id                  String    @id @default(cuid())
  shop                String
  importId            String
  productionJobId     String?
  productionJobItemId String?
  jobTicket           String?
  sourceJobName       String?
  printerSoftware     String?
  machineName         String?
  mediaName           String?
  status              String?
  sqft                Float     @default(0)
  inkMl               Float     @default(0)
  cmykInkMl           Float     @default(0)
  whiteInkMl          Float     @default(0)
  glossInkMl          Float     @default(0)
  printMinutes        Float     @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  rawRow              String?
  createdAt           DateTime  @default(now())

  import PrintLogImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([importId])
  @@index([productionJobId])
  @@index([productionJobItemId])
  @@index([jobTicket])
  @@index([sourceJobName])
  @@index([createdAt])
}

model PrintLogAutoImportSetting {
  id                    String    @id @default(cuid())
  shop                  String    @unique
  enabled               Boolean   @default(true)
  uploadToken           String    @unique
  incomingFolder        String?
  versaworksFolder      String?
  rasterlinkFolder      String?
  processedFolder       String?
  errorFolder           String?
  expectedTicketPattern String    @default("GSO-{date}-{jobNumber}-{sku}-{qty}")
  lastAutoImportAt      DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([enabled])
  @@index([lastAutoImportAt])
}

model PurchaseRequest {
  id            String @id @default(cuid())
  shop          String
  requestNumber String
  status        String @default("draft") // draft, requested, ordered, partially_received, received, cancelled
  priority      String @default("normal") // low, normal, rush, critical

  materialId   String?
  materialName String
  materialType String?
  unit         String  @default("each")
  sku          String?
  vendor       String?
  vendorId     String?
  vendorSku    String?
  moq          Float?
  leadTimeDays Int?

  requestedQty  Float @default(0)
  orderedQty    Float @default(0)
  receivedQty   Float @default(0)
  unitCost      Float @default(0)
  estimatedCost Float @default(0)

  neededBy                 DateTime?
  orderedAt                DateTime?
  sentAt                   DateTime?
  sentBy                   String?
  vendorConfirmationNumber String?
  expectedArrivalDate      DateTime?
  vendorReplyNotes         String?
  followUpNeeded           Boolean   @default(false)
  followUpDate             DateTime?
  lastFollowUpAt           DateTime?
  receivedAt               DateTime?
  cancelledAt              DateTime?
  notes                    String?
  source                   String    @default("manual") // manual, reorder_report, low_stock, production
  createdBy                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  vendorRecord Vendor? @relation("PurchaseRequestVendor", fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([shop])
  @@index([shop, status])
  @@index([materialId])
  @@index([vendor])
  @@index([vendorId])
  @@index([neededBy])
  @@index([sentAt])
  @@index([expectedArrivalDate])
  @@index([followUpNeeded])
  @@index([createdAt])
}

model Vendor {
  id              String   @id @default(cuid())
  shop            String
  name            String
  vendorType      String   @default("supplier") // supplier, print_vendor, packaging_vendor, service, other
  status          String   @default("active") // active, preferred, backup, inactive
  contactName     String?
  email           String?
  phone           String?
  website         String?
  address1        String?
  address2        String?
  city            String?
  state           String?
  zip             String?
  country         String?  @default("USA")
  paymentTerms    String?
  leadTimeDays    Int?
  moqNotes        String?
  shippingNotes   String?
  qualityNotes    String?
  notes           String?
  defaultCurrency String   @default("USD")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts         VendorContact[]
  primaryMaterials Material[]        @relation("MaterialPrimaryVendor")
  vendorProducts   VendorProduct[]   @relation("VendorProductVendor")
  purchaseRequests PurchaseRequest[] @relation("PurchaseRequestVendor")

  @@unique([shop, name])
  @@index([shop])
  @@index([shop, active])
  @@index([vendorType])
  @@index([status])
}

model VendorContact {
  id        String   @id @default(cuid())
  shop      String
  vendorId  String
  name      String
  role      String?
  email     String?
  phone     String?
  notes     String?
  primary   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([vendorId])
  @@index([primary])
  @@index([active])
}

model VendorCostBookItem {
  id              String    @id @default(cuid())
  shop            String
  vendorId        String?
  vendorName      String?
  itemType        String    @default("material") // material, vendor_product, sourced_product, service, other
  materialId      String?
  vendorProductId String?
  itemName        String
  vendorSku       String?
  unit            String    @default("each")
  unitCost        Float     @default(0)
  moq             Float?
  leadTimeDays    Int?
  effectiveDate   DateTime?
  expiresAt       DateTime?
  status          String    @default("active") // active, expired, draft, inactive
  preferred       Boolean   @default(false)
  currency        String    @default("USD")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tiers VendorCostBookTier[]

  @@index([shop])
  @@index([vendorId])
  @@index([vendorName])
  @@index([itemType])
  @@index([materialId])
  @@index([vendorProductId])
  @@index([status])
  @@index([preferred])
  @@index([effectiveDate])
}

model VendorCostBookTier {
  id                   String   @id @default(cuid())
  shop                 String
  vendorCostBookItemId String
  minQty               Float    @default(1)
  maxQty               Float?
  unitCost             Float    @default(0)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  costBookItem VendorCostBookItem @relation(fields: [vendorCostBookItemId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([vendorCostBookItemId])
  @@index([minQty])
}

model ErpAdminSetting {
  id          String   @id @default(cuid())
  shop        String
  category    String
  key         String
  label       String
  value       String   @default("")
  valueType   String   @default("text") // text, number, percent, money, boolean, textarea, select
  unit        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, key])
  @@index([shop])
  @@index([category])
  @@index([key])
}

model MarginReviewSetting {
  id                           String   @id @default(cuid())
  shop                         String
  laborRatePerHour             Float    @default(25)
  applicationLaborFloorPerSide Float    @default(0.20)
  auditRowLimit                Int      @default(150)
  warningBandPct               Float    @default(5)
  costReviewThresholdPct       Float    @default(0)
  active                       Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@index([shop])
}
