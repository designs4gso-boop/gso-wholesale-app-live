generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  refreshToken        String?
  refreshTokenExpires DateTime?
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
}

model ShopSettings {
  id                  Int      @id @default(autoincrement())
  shop                String   @unique
  wholesaleTag        String   @default("wholesale_approved")
  pendingTag          String   @default("wholesale_pending")
  vipTag              String   @default("vip_wholesale")
  applicationMode     String   @default("manual")
  storewidePercentOff Float    @default(0)
  minimumSubtotal     Float    @default(0)
  minCartQuantity     Int      @default(1)
  enforceMinCartQty   Boolean  @default(false)
  lockWholesaleAccess Boolean  @default(false)
  autoCreateDiscount  Boolean  @default(false)
  wholesaleDiscountId String?
  validationOwnerId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  rules        WholesaleRule[]
  applications WholesaleApplication[]
}

model WholesaleRule {
  id                 Int      @id @default(autoincrement())
  shop               String
  customerTag        String
  title              String
  scopeType          String
  scopeId            String?
  scopeLabel         String?
  discountType       String
  value              Float
  minQuantity        Int      @default(1)
  minProductQuantity Int?
  minCartQuantity    Int?
  minSubtotal        Float?
  priority           Int      @default(100)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  settingsId Int?
  settings   ShopSettings? @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([shop, active])
  @@index([shop, customerTag])
  @@index([shop, scopeType, scopeId])
}

model WholesaleApplication {
  id           Int      @id @default(autoincrement())
  shop         String
  customerId   String
  email        String
  companyName  String?
  phone        String?
  taxId        String?
  resaleNumber String?
  notes        String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settingsId Int?
  settings   ShopSettings? @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([shop, status])
}

model PricingRule {
  id          String   @id @default(cuid())
  shop        String
  title       String

  customerTag String?
  productTag  String?
  productGid  String?
  variantGid  String?
  sku         String?

  minQty       Int     @default(1)
  discountType String  @default("fixed_price") // fixed_price or percent_off
  sellPrice    Float?
  percentOff   Float?
  unitCost     Float?

  priority    Int      @default(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop, active])
  @@index([shop, customerTag])
  @@index([shop, productTag])
  @@index([shop, variantGid])
  @@index([shop, sku])
}

model CostCalculator {
  id              String   @id @default(cuid())
  shop            String
  title           String
  materialCost    Float
  printCost       Float
  laborCost       Float
  machineCost     Float
  wastePercent    Float
  packagingCost   Float
  setupFee        Float
  suggestedMargin Float
  createdAt       DateTime @default(now())
}

model Quote {
  id           String   @id @default(cuid())
  shop         String
  customerName String?
  company      String?
  email        String?
  phone        String?
  status       String   @default("draft")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        QuoteItem[]

  depositAmount       Float   @default(0)
  balanceDue          Float   @default(0)
  depositCreated      Boolean @default(false)
  balanceCreated      Boolean @default(false)
  fullOrderCreated    Boolean @default(false)
  depositDraftOrderId String?
  balanceDraftOrderId String?
  fullDraftOrderId    String?
  
  depositInvoiceUrl String?
  balanceInvoiceUrl String?
  fullInvoiceUrl    String?

  @@index([shop, status])
  @@index([shop, createdAt])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  productName String
  variant     String?
  sku         String?
  quantity    Int
  unitPrice   Float
  unitCost    Float
  notes       String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}


model ProductCost {
  id   String @id @default(cuid())
  shop String @default("")

  productId   String?
  variantId   String?
  sku         String?
  productName String?
  name        String?

  materialCost  Float @default(0)
  printCost     Float @default(0)
  laborCost     Float @default(0)
  machineCost   Float @default(0)
  packagingCost Float @default(0)

  customCosts Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([variantId])
  @@index([sku])
  @@index([productName])
}

model ProductCategory {
  id        String   @id @default(cuid())
  shop      String
  name      String
  slug      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes   ProductRecipe[]
  materials Material[]

  @@index([shop])
  @@unique([shop, slug])
}

model Material {
  id              String   @id @default(cuid())
  shop            String
  categoryId      String?
  name            String
  materialType    String   @default("general") // label, dtp, box, ink, laminate, labor, machine, general
  unit            String   @default("each") // each, sqft, linear_ft, ml, hour, roll, sheet
  costPerUnit     Float    @default(0)
  vendor          String?
  sku             String?
  stockOnHand     Float?
  reorderPoint    Float?
  leadTimeDays    Int?
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  purchaseUnit       String   @default("each") // roll, cartridge, gallon, case, each, hour
purchaseCost       Float    @default(0)

baseUnit           String   @default("each") // sqft, sqin, ml, each, hour
yieldQuantity      Float?
yieldUnit          String?

rollWidthIn        Float?
rollLengthFt       Float?
volumeMl           Float?
caseQuantity       Float?

calculatedUnitCost Float    @default(0)

  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  recipeMaterials RecipeMaterial[]
  costHistory MaterialCostHistory[]
  vendors     MaterialVendor[]

  @@index([shop])
  @@index([shop, materialType])
  @@index([shop, active])
}

model ProductRecipe {
  id              String   @id @default(cuid())
  shop            String
  categoryId      String?
  name            String
  sku             String?
  productGid      String?
  variantGid      String?
  costMethod      String   @default("recipe") // recipe, sourced_flat, sourced_tier
  defaultSellPrice Float?
  targetMarginPct Float    @default(40)
  wastePct        Float    @default(0)
  setupCost       Float    @default(0)
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  materials       RecipeMaterial[]
  sourcedTiers    SourcedCostTier[]

  @@index([shop])
  @@index([shop, sku])
  @@index([shop, productGid])
  @@index([shop, variantGid])
  @@index([shop, active])
}

model RecipeMaterial {
  id          String   @id @default(cuid())
  shop        String
  recipeId    String
  materialId  String
  quantity    Float    @default(1)
  usageType   String   @default("per_unit") // per_unit or per_job
  includeWaste Boolean @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe      ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material    Material      @relation(fields: [materialId], references: [id])

  @@index([shop])
  @@index([recipeId])
  @@index([materialId])
}

model SourcedCostTier {
  id          String   @id @default(cuid())
  shop        String
  recipeId    String
  minQty      Int
  unitCost    Float
  vendor      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe      ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([recipeId])
  @@index([minQty])
}

model MaterialCostHistory {
  id          String   @id @default(cuid())
  shop        String
  materialId  String
  oldCost     Float
  newCost     Float
  vendor      String?
  reason      String?
  changedBy   String?
  createdAt   DateTime @default(now())

  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([materialId])
}

model MaterialVendor {
  id          String   @id @default(cuid())
  shop        String
  materialId  String
  vendorName  String
  vendorSku   String?
  unitCost    Float    @default(0)
  unit         String   @default("each")
  moq          Float?
  leadTimeDays Int?
  notes       String?
  preferred   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([materialId])
  @@index([shop, active])
}

model Machine {
  id            String   @id @default(cuid())
  shop          String

  name          String
  machineType   String   @default("printer") // printer, cutter, laminator, press
  maxWidthIn    Float?
  costPerHour   Float    @default(0)
  sqftPerHour   Float    @default(0)
  setupWastePct Float    @default(0)

  allowOverflow Boolean  @default(false)
  active        Boolean  @default(true)

  inkChannels   MachineInkChannel[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shop])
  @@index([shop, active])
}

model MachineInkChannel {
  id            String   @id @default(cuid())
  shop          String
  machineId     String

  slotNumber    Int
  inkName       String   // Cyan, Magenta, Yellow, Black, White, Gloss, Orange, Red, Green, etc.
  inkType       String   // cmyk, white, gloss, orange, red, green, primer, metallic, other

  costPerMl     Float    @default(0)

  cartridgeCost Float @default(0)
  cartridgeMl   Float @default(0)
  mlPerSqft1Pct Float @default(0)

  // ML used per sqft at 100% coverage for this ink/channel
  mlPerSqft100  Float    @default(0)

  enabled       Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machine       Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([machineId])
  @@index([inkType])
}