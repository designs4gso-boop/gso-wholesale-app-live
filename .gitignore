node_modules
.env
.env.*
# 15G.5E rollback/checkpoint artifacts (full product description snapshots) stay local.
tools/moq-cleanup-data/
# 16B storefront-safety rollback artifacts stay local.
tools/storefront-16b-data/
# 16C legacy-bag rebuild rollback artifacts (full variant snapshots) stay local.
tools/rebuild-16c-data/
# Local watcher/agent configs hold the real upload token - only *.example.json is committed.
tools/gso-rasterlink-sync-config.json
tools/gso-rasterlink-sync.config.json
tools/gso-print-intake-config.json
tools/gso-print-intake-agent-config.json
tools/gso-roland-sync-config.json
tools/gso-roland-sync.config.json
# 2C-2: dated/suffixed BACKUPS of those configs carry the same live token
# (e.g. gso-rasterlink-sync.config.pre-2c1.json). The rules above match exact
# names only, and tools/*.bak does not match a .json backup.
tools/gso-rasterlink-sync.config.*.json
tools/gso-rasterlink-sync-config.*.json
tools/gso-roland-sync.config.*.json
tools/gso-roland-sync-config.*.json
tools/gso-print-intake-config.*.json
tools/gso-print-intake-agent-config.*.json
# ...but the committed templates must stay tracked.
!tools/gso-rasterlink-sync-config.example.json
!tools/gso-roland-sync-config.example.json
!tools/gso-print-intake-agent-config.example.json
tools/*.bak
dist
build
.cache
.prisma
.DS_Store
*.log
coverage
.vscode
.idea
.shopify
.react-router/
