{% schema %}
{
  "name": "GSO Product Configurator",
  "target": "section",
  "javascript": "gso-product-configurator.js",
  "stylesheet": "gso-product-configurator.css",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GSO Custom Stock Bag" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Bag" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Choose your material, finish, bag color, and quantity." },
    { "type": "number", "id": "minimum_quantity", "label": "Legacy minimum quantity (deprecated)", "default": 50 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "default": "card",
      "options": [
        { "value": "card", "label": "Card" },
        { "value": "compact", "label": "Compact" },
        { "value": "minimal", "label": "Minimal" }
      ]
    },
    { "type": "color", "id": "background_color", "label": "Card background", "default": "#120004" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text color", "default": "#d8cfd1" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#ff1f1f" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#ff1f1f" },
    { "type": "color", "id": "field_background", "label": "Dropdown background", "default": "#050505" },
    { "type": "color", "id": "field_text_color", "label": "Dropdown text color", "default": "#ffffff" },
    { "type": "color", "id": "result_background", "label": "Result box background", "default": "#1b080b" },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 32, "step": 2, "default": 16 },

    { "type": "checkbox", "id": "show_price_each", "label": "Show price per unit", "default": true },
    { "type": "checkbox", "id": "show_order_total", "label": "Show order total", "default": false },
    { "type": "checkbox", "id": "show_matched_tier", "label": "Show matched tier", "default": false },
    { "type": "checkbox", "id": "show_price_breaks", "label": "Show price break chart", "default": true },
    { "type": "checkbox", "id": "show_profit_data", "label": "Show internal profit/cost data", "default": false }
  ]
}
{% endschema %}

{% assign selected_variant = product.selected_or_first_available_variant %}

<div
  class="gso-configurator gso-configurator--{{ block.settings.layout }}"
  {{ block.shopify_attributes }}
  data-configurator-proxy="/apps/wholesale-lite/configurator"
  data-checkout-proxy="/apps/wholesale-lite/configurator-checkout"
  data-customer-email="{% if customer %}{{ customer.email | escape }}{% endif %}"
  data-shop="{{ shop.permanent_domain | escape }}"
  data-product-handle="{{ product.handle | escape }}"
  data-product-gid="gid://shopify/Product/{{ product.id }}"
  data-base-variant-gid="gid://shopify/ProductVariant/{{ selected_variant.id }}"
  {%- comment -%}
    15G.5C: the saved block-instance setting (64 on the live theme) can never
    retro-update from a schema default change, so customer-facing MOQ no longer
    renders from block settings at all. 50 is the canonical fallback; the
    server's minQuantity overrides everything at runtime.
  {%- endcomment -%}
  data-minimum-quantity="50"
  data-show-price-each="{{ block.settings.show_price_each }}"
  data-show-order-total="{{ block.settings.show_order_total }}"
  data-show-matched-tier="{{ block.settings.show_matched_tier }}"
  data-show-price-breaks="{{ block.settings.show_price_breaks }}"
  data-show-profit-data="{{ block.settings.show_profit_data }}"
  style="
    --gso-card-bg: {{ block.settings.background_color }};
    --gso-text: {{ block.settings.text_color }};
    --gso-muted: {{ block.settings.muted_text_color }};
    --gso-accent: {{ block.settings.accent_color }};
    --gso-border: {{ block.settings.border_color }};
    --gso-field-bg: {{ block.settings.field_background }};
    --gso-field-text: {{ block.settings.field_text_color }};
    --gso-result-bg: {{ block.settings.result_background }};
    --gso-radius: {{ block.settings.border_radius }}px;
  "
>
  <div class="gso-configurator__inner">
    <p class="gso-configurator__eyebrow">{{ block.settings.eyebrow }}</p>
    <h3 class="gso-configurator__title" data-gso-copy="heading">{{ block.settings.heading }}</h3>
    <p class="gso-configurator__subheading" data-gso-copy="subheading">{{ block.settings.subheading }}</p>

    <div class="gso-configurator__loading">Loading custom bag options...</div>

    <div class="gso-configurator__app" hidden>
      <div class="gso-configurator__fields">
        <label class="gso-configurator__field">
          <span>Material</span>
          <select data-gso-field="material"></select>
        </label>

        <label class="gso-configurator__field">
          <span>Finish</span>
          <select data-gso-field="finish"></select>
        </label>

        <label class="gso-configurator__field">
          <span>Bag Color</span>
          <select data-gso-field="bagColor"></select>
        </label>

        <label class="gso-configurator__field" data-gso-field-row="labelSet" hidden>
          <span>Label Set</span>
          <select data-gso-field="labelSet"></select>
        </label>

        <label class="gso-configurator__field" data-gso-field-row="jarColor" hidden>
          <span>Jar Color</span>
          <select data-gso-field="jarColor"></select>
        </label>

        <label class="gso-configurator__field">
          <span>Quantity</span>
          <input data-gso-field="quantity" type="number" min="50" step="1" value="50">
        </label>
      </div>

      <div class="gso-configurator__summary">
        <div class="gso-configurator__result" data-gso-result="priceEachBox">
          <span>Price Per Unit</span>
          <strong><span data-gso-result="priceEach">-</span> <small>each</small></strong>
        </div>

        <div class="gso-configurator__result" data-gso-result="orderTotalBox">
          <span>Order Total</span>
          <strong data-gso-result="orderTotal">-</strong>
        </div>

        <div class="gso-configurator__result" data-gso-result="matchedTierBox">
          <span>Matched Tier</span>
          <strong data-gso-result="matchedTier">-</strong>
        </div>
      </div>

      <div class="gso-configurator__notice" data-gso-result="notice">
        Sides are set to Double Sided. Minimum order is <span data-gso-min-display>50</span> units.
      </div>

      <button type="button" class="gso-configurator__add" data-gso-add-to-cart>
        Add to Cart
      </button>

      <div class="gso-configurator__breaks" data-gso-result="priceBreaksBox" hidden>
        <div class="gso-configurator__breaks-title">Price Breaks</div>
        <div class="gso-configurator__breaks-table" data-gso-result="priceBreaks"></div>
      </div>

      <div class="gso-configurator__internal" data-gso-result="internalBox" hidden>
        <div>Cost Each: <strong data-gso-result="costEach">-</strong></div>
        <div>Margin: <strong data-gso-result="margin">-</strong></div>
      </div>
    </div>

    <div class="gso-configurator__error" hidden></div>

    <noscript>
      <div class="gso-configurator__error">Enable JavaScript to use the GSO product configurator.</div>
    </noscript>
  </div>
</div>


