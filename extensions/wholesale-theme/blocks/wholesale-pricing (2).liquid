{% schema %}
{
  "name": "Wholesale pricing",
  "target": "section",
  "javascript": "wholesale-pricing.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wholesale pricing available"
    },
    {
      "type": "checkbox",
      "id": "show_price_table",
      "label": "Show current pricing summary",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tier_table",
      "label": "Show quantity tier table",
      "default": true
    }
  ]
}
{% endschema %}

{% assign selected_variant = product.selected_or_first_available_variant %}

<div
  class="wholesale-pricing-block"
  data-app-proxy="/apps/wholesale-lite/pricing"
  data-product-id="{{ product.id | prepend: 'gid://shopify/Product/' }}"
  data-selected-variant-id="{{ selected_variant.id | prepend: 'gid://shopify/ProductVariant/' }}"
  data-variant-ids="{% for v in product.variants %}gid://shopify/ProductVariant/{{ v.id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  data-variant-titles="{% for v in product.variants %}{{ v.title | escape }}{% unless forloop.last %}|||{% endunless %}{% endfor %}"
  data-variant-prices="{% for v in product.variants %}{{ v.price | money_without_currency | replace: ',', '' }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  data-show-table="{{ block.settings.show_price_table }}"
  data-show-tier-table="{{ block.settings.show_tier_table }}"
  data-heading="{{ block.settings.heading | escape }}"
  style="
    padding:16px;
    margin:20px 0;
    border:1px solid rgba(255,255,255,0.15);
    border-radius:12px;
    background:rgba(255,255,255,0.04);
    color:#fff;
  "
>
  <div class="wholesale-pricing-content">
    <div class="wsp-loading">Loading wholesale pricing...</div>
    <noscript>
      <div class="wsp-inner">
        <h3 class="wsp-heading">{{ block.settings.heading }}</h3>
        <p>Enable JavaScript to see live quantity pricing.</p>
      </div>
    </noscript>
  </div>
</div>